# This script is installed on the Mikrotik wAP ax wireless router.
# It detects people via known MAC addresses and posts them to the backend.

# Set to true to skip the HTTP POST and simply log to console
:local debug false

# Define the specific MAC addresses to track (generated from devices.config.ts during build)
:local trackedMacs [:toarray ""]
:set trackedMacs ($trackedMacs, "00:00:00:00:00:01"); # Sample Device


:local activeTracked ""
:local q "\""

# check if router has been powered on for at least 5 minutes
:if ([/system resource get uptime] < 5m) do={
    :log info "Presence Tracker: Skipping run (Router booted less than 5m ago, letting Starlink settle)"
    :error "Boot delay active"
}

# detection logic
:foreach mac in=$trackedMacs do={
    :if ([:len [/interface/wifi/registration-table find where mac-address=$mac]] > 0) do={
        # Wraps each MAC in literal quotes: "MAC",
        :set activeTracked ($activeTracked . $q . $mac . $q . ",")
    }
}

# construct payload
:local macArray ""
:if ([:len $activeTracked] > 0) do={
    # Remove trailing comma
    :set macArray [:pick $activeTracked 0 ([:len $activeTracked] - 1)]
}
:local payload "{\"present\":[$macArray]}"

# deliver it
:if ($debug = false) do={
    # Production Mode (With Outbound Starlink Failsafe)
    :do {
        /tool fetch http-method=post http-data=$payload \
            url="https://presence-rtsxjuo3va-uc.a.run.app" \
            http-header-field="Content-Type: application/json,Authorization: Bearer 2080A250-CCA3-4317-9535-2D03F0FC5698" \
            keep-result=no
    } on-error={
        # Silently catch DNS/connection errors when Starlink is offline
        :log info "Presence Tracker: Outbound POST failed (Internet down or Starlink sleeping)"
    }
} else={
    # Local Testing Mode
    :put "DEBUG: Payload: $payload"
    :log info "Presence Tracker - $payload"
}