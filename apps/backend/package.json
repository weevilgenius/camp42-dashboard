{
  "name": "@camp42/backend",
  "version": "0.1.0",
  "description": "Backend for camp dashboard",
  "main": "dist/index.js",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "build": "tsup",
    "lint": "eslint src tests",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "serve": "pnpm run build && cd .. && firebase emulators:start --only functions",
    "test": "vitest run"
  },
  "author": "",
  "packageManager": "pnpm@10.30.1+sha512.3590e550d5384caa39bd5c7c739f72270234b2f6059e13018f975c313b1eb9fefcc09714048765d4d9efe961382c312e624572c0420762bdc5d5940cdf9be73a",
  "engines": {
    "node": "24"
  },
  "dependencies": {
    "@google-cloud/functions-framework": "^5.0.2",
    "firebase-admin": "^13.7.0",
    "firebase-functions": "^7.1.0"
  },
  "devDependencies": {
    "dotenv": "^17.3.1",
    "firebase-functions-test": "^3.4.1",
    "tsup": "^8.5.1"
  }
}
