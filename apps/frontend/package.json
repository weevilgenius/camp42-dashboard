{
  "name": "@camp42/frontend",
  "version": "0.1.1",
  "description": "Frontend for camp dashboard",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "lint": "eslint src tests",
    "dev": "VITE_USE_EMULATOR=true vite --host",
    "dev:mock": "VITE_USE_MOCKS=true vite --host",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "analyze": "tsc -p tsconfig.app.json --noEmit && ANALYZE=1 vite build",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "serve": "pnpm run build && cd .. && firebase emulators:start --only hosting",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "private": true,
  "engines": {
    "node": "24"
  },
  "packageManager": "pnpm@10.30.3+sha512.c961d1e0a2d8e354ecaa5166b822516668b7f44cb5bd95122d590dd81922f606f5473b6d23ec4a5be05e7fcd18e8488d47d978bbe981872f1145d06e9a740017",
  "dependencies": {
    "@awesome.me/webawesome": "^3.10.0",
    "@camp42/shared": "workspace:*",
    "firebase": "^12.15.0",
    "mithril": "^2.3.8"
  },
  "devDependencies": {
    "@camp42/mocks": "workspace:*",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/web-components-vite": "^10.4.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/mithril": "^2.2.8",
    "@typescript-eslint/utils": "^8.63.0",
    "@vitest/coverage-v8": "^4.1.10",
    "happy-dom": "^20.10.6",
    "lit": "^3.3.3",
    "rollup-plugin-visualizer": "^7.0.1",
    "storybook": "^10.4.6",
    "vite": "^8.1.3"
  }
}
