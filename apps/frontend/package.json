{
  "name": "@camp42/frontend",
  "version": "0.3.0",
  "description": "Frontend for camp dashboard",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "postinstall": "playwright install chromium",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "lint": "eslint src tests scripts",
    "dev": "VITE_USE_EMULATOR=true vite --host",
    "dev:mock": "VITE_USE_MOCKS=true vite --host",
    "screenshot": "node --import tsx scripts/screenshot.ts",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "analyze": "tsc -p tsconfig.app.json --noEmit && ANALYZE=1 vite build",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "serve": "pnpm run build && cd .. && firebase emulators:start --only hosting",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "private": true,
  "engines": {
    "node": "24"
  },
  "dependencies": {
    "@awesome.me/webawesome": "^3.13.0",
    "@camp42/shared": "workspace:*",
    "firebase": "^12.19.0",
    "mithril": "^2.3.8"
  },
  "devDependencies": {
    "@camp42/mocks": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/web-components-vite": "^10.6.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/user-event": "^14.6.7",
    "@types/mithril": "^2.2.9",
    "@typescript-eslint/utils": "^8.70.0",
    "@vitest/coverage-v8": "^5.0.1",
    "happy-dom": "^20.14.5",
    "lit": "^3.3.3",
    "rollup-plugin-visualizer": "^7.1.1",
    "storybook": "^10.6.0",
    "vite": "^8.3.0"
  }
}
