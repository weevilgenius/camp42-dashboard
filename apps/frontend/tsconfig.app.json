{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": [
      "vitest/globals", // to reduce type imports in test files
      "vite/client"
    ],
    "useDefineForClassFields": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"]
    },
  },
  "include": [
    ".storybook/*.ts",
    "src",
    "tests"
  ]
}