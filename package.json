{
  "name": "camp-dashboard",
  "version": "0.3.0",
  "description": "Dashboard for Camp 42",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm --recursive run build",
    "lint": "eslint .",
